# BeePrepared configuration
#
#   cp .env.example .env
#
# Every value has a working default. The only one worth setting is
# OPENROUTER_API_KEY: without it the backend falls back to a local heuristic
# engine that runs the whole pipeline with much duller output.

# --- Model ---------------------------------------------------------------
# One key covers generation and audio transcription: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Speech to text ------------------------------------------------------
# Optional. Deepgram is built for speech and does a better job on a long
# recording than a general model does, so it is used for transcription
# whenever a key is present, with the model above kept as the fallback.
# Leave it empty and the model above does the listening on its own.
# Keys: https://console.deepgram.com
DEEPGRAM_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_TIMEOUT_SECONDS=600

LLM_MAX_CONCURRENCY=6
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# --- Local data ----------------------------------------------------------
# The SQLite database and every stored file live here. Delete it to reset.
BEE_DATA_DIR=./backend/.storage

# Signs download links. Change this for anything internet-facing.
SIGNING_SECRET=change-me-in-production

# --- Queue ---------------------------------------------------------------
# With Redis set, jobs run in Celery workers that scale separately from the API.
# Leave it empty and the API runs its own worker pool instead.
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=true

WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3
STALE_JOB_SECONDS=1800

# --- HTTP ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE_MB=200

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
