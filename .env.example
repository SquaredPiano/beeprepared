# =============================================================================
# BeePrepared configuration
#
#   cp .env.example .env
#
# Every value below has a working default. The only one worth setting to see
# the product at its best is OPENROUTER_API_KEY - without it the backend falls
# back to a local heuristic engine that still runs the whole pipeline, just
# with much duller output.
# =============================================================================

# -----------------------------------------------------------------------------
# AI model (recommended)
# -----------------------------------------------------------------------------
# One key covers every model. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# openrouter | gemini | vertex | offline | auto
# "auto" picks the first provider whose credentials are present.
LLM_PROVIDER=openrouter

LLM_MAX_CONCURRENCY=6      # in-flight model requests per process
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# local    - embedded SQLite. No accounts, no setup, survives restarts. Default.
# supabase - hosted Postgres. Requires SUPABASE_URL and SUPABASE_KEY below.
# auto     - use Supabase when it is configured and reachable, else local.
DATABASE_BACKEND=local

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Object storage (uploads and rendered PDFs / decks)
# -----------------------------------------------------------------------------
# local - files on disk, served back through signed /api/files URLs. Default.
# r2    - Cloudflare R2. Requires the R2_* values below.
# auto  - use R2 when it is configured and the bucket answers, else local.
STORAGE_BACKEND=local
BEE_STORAGE_DIR=./backend/.storage

# Signs local download links. Change this for anything internet-facing.
STORAGE_SIGNING_SECRET=change-me-in-production

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Queue and workers
# -----------------------------------------------------------------------------
# With Redis set and CELERY_ENABLED=true, jobs run in Celery workers that scale
# separately from the API. Leave REDIS_URL empty and the API runs its own
# in-process worker pool instead - same code path, one fewer moving part.
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=true

WORKER_CONCURRENCY=4       # workers in the in-process pool
JOB_TIMEOUT_SECONDS=900    # a job past this is killed and requeued
JOB_MAX_ATTEMPTS=3         # attempts before a transient failure becomes final
STALE_JOB_SECONDS=1800     # a `running` job older than this is treated as dead

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE_MB=200

# Accept the frontend's dev token. Implied when DATABASE_BACKEND=local;
# set it explicitly only if you know why you want it against a real database.
ALLOW_MOCK_AUTH=true

# -----------------------------------------------------------------------------
# Speech-to-text (optional - only needed for audio and video sources)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
